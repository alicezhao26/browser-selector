{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite"],
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+C", "mac": "Alt+C" },
      "description": "__MSG_cmdTogglePicker__"
    },
    "screenshot-visible": {
      "suggested_key": { "default": "Alt+S", "mac": "Alt+S" },
      "description": "__MSG_cmdScreenshotVisible__"
    },
    "screenshot-full": {
      "suggested_key": { "default": "Alt+A", "mac": "Alt+A" },
      "description": "__MSG_cmdScreenshotFull__"
    }
  }
}
